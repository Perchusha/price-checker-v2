{
  "name": "price-checker",
  "version": "1.0.0",
  "description": "Price monitoring application for tracking product prices",
  "main": "public/electron.js",
  "homepage": "./",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.15.0",
    "yarn": "1.22.22"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-is-dev": "^2.0.0",
    "lucide-react": "^1.14.0",
    "node-notifier": "^10.0.1",
    "postcss": "^8.4.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.11.0",
    "react-scripts": "5.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "concurrently": "^8.0.1",
    "electron": "^24.0.0",
    "electron-builder": "^24.4.0",
    "wait-on": "^7.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "concurrently \"yarn start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "yarn build && electron-builder",
    "preelectron-pack": "yarn build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.pricechecker.app",
    "productName": "Price Checker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/price-checker.js",
      "public/settings-manager.js",
      "public/scraper/**/*",
      "public/logo.png",
      "public/logo-alert.png",
      "public/favicon.ico",
      "public/icon.png",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "public/scraper/**/*"
    ],
    "icon": "public/logo.png",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/logo.png"
    },
    "win": {
      "target": "nsis",
      "icon": "public/logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/logo.png"
    }
  }
}
